# App display name (optional, client-side)
NEXT_PUBLIC_APP_NAME=PreVisit MVP

# Client-side API base URL (browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side URL for Next.js API routes (/api/auth/*, /api/proxy/*).
# Required in production on Liara. Point this at the FastAPI backend app.
BACKEND_API_URL=http://localhost:8000

# Production examples:
# NEXT_PUBLIC_API_URL=https://reverent-antonelli-q68ozcda4.liara.run
# BACKEND_API_URL=https://reverent-antonelli-q68ozcda4.liara.run
