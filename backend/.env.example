# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/previsit

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen-2.5-72b-instruct
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GAPGPT_MODEL=gapgpt-qwen-3.5

# OpenRouter (primary LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_TITLE=PreVisit MVP

# Outbound HTTP proxy for LLM API calls
HTTP_PROXY=http://127.0.0.1:10809

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Runtime
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Rate limiting
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
