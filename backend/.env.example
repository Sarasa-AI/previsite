# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=previsit
# Or use the full URL (will override individual settings)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/previsit

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
LLM_PROVIDER=openrouter
LLM_MODEL=qwen/qwen-2.5-72b-instruct
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GAPGPT_MODEL=gapgpt-qwen-3.5

# OpenRouter (primary LLM provider)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_HTTP_REFERER=https://sarasa-ai.liara.run
OPENROUTER_APP_TITLE=PreVisit MVP

# Outbound HTTP proxy for LLM API calls (optional)
HTTP_PROXY=

# Ollama (Phase 2 RAG — local embeddings)
OLLAMA_HOST=http://ollama:11434

# File Storage (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=previsit-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
MAX_FILE_SIZE=10485760

# Runtime
APP_ENV=production
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://sarasa-ai.liara.run
LOG_LEVEL=INFO
SKIP_HEALTH_CHECK=true

# Rate limiting
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
