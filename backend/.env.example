# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=previsit
# Or use the full URL (will override individual settings)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/previsit

# JWT — REQUIRED: set a long random value. Placeholders fail startup.
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
# Short-lived access JWT (minutes). Session continuity uses refresh tokens.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Opaque rotating refresh tokens (hash-at-rest). Idle = inactivity window;
# absolute = max family lifetime from first issue.
REFRESH_TOKEN_IDLE_MINUTES=60
REFRESH_TOKEN_ABSOLUTE_DAYS=7

# P2-B OTP / SMS (console|test for local; real provider required in production)
SMS_PROVIDER=console
OTP_LOGIN_ENABLED=true
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_PER_PHONE_LIMIT=5
OTP_REQUEST_PER_PHONE_WINDOW_SECONDS=900
OTP_REQUEST_PER_IP_LIMIT=20
OTP_REQUEST_PER_IP_WINDOW_SECONDS=900
OTP_PHONE_DAILY_CAP=10
LEGACY_PATIENT_PASSWORD_LOGIN_ENABLED=true

# P2-B LLM de-identification gateway
EXTERNAL_LLM_DEIDENTIFICATION_ENABLED=true
ALLOW_EXTERNAL_IMAGE_INFERENCE=false
EXTERNAL_LLM_PROVIDER_ALLOWLIST=openrouter.ai,api.gapgpt.app
LLM_SCRUB_DATE_MODE=year
LLM_EGRESS_LOG_RETENTION_DAYS=90

# Default doctor seed (password required in production; optional elsewhere)
SEED_DOCTOR_USERNAME=bagherzade
SEED_DOCTOR_PASSWORD=

# Multi-doctor RBAC: false = enforce doctor_id ownership (recommended)
SINGLE_DOCTOR_MODE=false

# LLM
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GAPGPT_API_KEY=
GAPGPT_BASE_URL=https://api.gapgpt.app/v1
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-2.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GAPGPT_MODEL=gapgpt-qwen-3.5

# OpenRouter (primary LLM provider)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash-lite
# Intake LLM (fast structured JSON for HPI questions + clinical summary)
INTAKE_LLM_MODEL=google/gemini-2.5-flash-lite
INTAKE_LLM_TIMEOUT_SECONDS=20

# LLM cascade / circuit breaker
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_COOLDOWN_SECONDS=60
# Tier 2 fallback provider: gapgpt | ollama | openrouter
LLM_TIER2_PROVIDER=gapgpt
LLM_TIER2_OLLAMA_MODEL=llama3.2
LLM_TIER2_OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

OPENROUTER_HTTP_REFERER=https://sarasa-ai.liara.run
OPENROUTER_APP_TITLE=PreVisit MVP

# Outbound HTTP proxy for LLM API calls (optional).
# Only set when a local proxy/VPN is actually running (e.g. http://127.0.0.1:10809).
# Leave empty for direct internet access.
HTTP_PROXY=

# Ollama (Phase 2 RAG — local embeddings)
OLLAMA_HOST=http://ollama:11434
# auto | ollama | openrouter — auto falls back to OpenRouter when Ollama is down
EMBEDDING_PROVIDER=auto
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# Optional CrossEncoder rerank after pgvector cosine retrieval (set false for fast rollback)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_CANDIDATES=20

# File Storage
# Local dev: set UPLOAD_DIR to store files on disk (no MinIO required).
# Production/docker: leave UPLOAD_DIR empty and use S3-compatible storage below.
UPLOAD_DIR=./uploads
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=previsit-files
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_USE_SSL=false
MAX_FILE_SIZE=10485760

# Runtime — use "development" for local docker-compose defaults (postgres/minioadmin).
# APP_ENV=production rejects those defaults at startup.
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,https://sarasa-ai.liara.run
LOG_LEVEL=INFO
SKIP_HEALTH_CHECK=true

# Observability (optional — empty disables Sentry)
SENTRY_DSN=
# Optional static bearer for GET /metrics scrapers (admin JWT also allowed).
# Leave unset in production to hide anonymous access (404); set for Prometheus.
METRICS_BEARER_TOKEN=

# Doctor MFA / TOTP (default off so existing tests keep working)
MFA_ENABLED=false
DOCTOR_MFA_REQUIRED=false
ADMIN_MFA_REQUIRED=false

# Consent enforcement (P2-A). Default off — API/structure only until legal copy lands.
CONSENT_ENFORCEMENT_ENABLED=false
CONSENT_VERSION_AI_PROCESSING=v1
CONSENT_VERSION_DATA_PROCESSING=v1
CONSENT_VERSION_RECORDING=v1
CONSENT_VERSION_EXTERNAL_LLM_PROCESSING=v1

# Patient data export / account erasure (P2-A). Confirm LEGAL_RETENTION_* with product owner.
ACCOUNT_DELETION_COOL_OFF_HOURS=72
LEGAL_RETENTION_KEEP_SESSION_SHELL=true
LEGAL_RETENTION_KEEP_PMH_SHELL=true
PRIVACY_EXPORT_RATE_LIMIT_REQUESTS=3
PRIVACY_EXPORT_RATE_LIMIT_WINDOW_SECONDS=86400
PRIVACY_EXPORT_DOWNLOAD_URL_SECONDS=3600
PRIVACY_EXPORT_BUNDLE_TTL_HOURS=168
# Fernet key for encrypting mfa_secret at rest. Required when MFA_ENABLED=true
# in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Rate limiting (in-process / per-worker only — not distributed)
CHAT_RATE_LIMIT_REQUESTS=20
CHAT_RATE_LIMIT_WINDOW_SECONDS=60
INTAKE_WRITE_RATE_LIMIT_REQUESTS=60
INTAKE_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
FILE_UPLOAD_RATE_LIMIT_REQUESTS=30
FILE_UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
PDF_EXPORT_RATE_LIMIT_REQUESTS=20
PDF_EXPORT_RATE_LIMIT_WINDOW_SECONDS=60
OCR_READ_RATE_LIMIT_REQUESTS=60
OCR_READ_RATE_LIMIT_WINDOW_SECONDS=60
MEDICATIONS_SEARCH_RATE_LIMIT_REQUESTS=60
MEDICATIONS_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
MFA_VERIFY_RATE_LIMIT_REQUESTS=10
MFA_VERIFY_RATE_LIMIT_WINDOW_SECONDS=300
# Auth brute-force (login is shared by patients and doctors — no separate doctor-login)
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_LOCKOUT_SECONDS=900
AUTH_REGISTER_MAX_REQUESTS=20
AUTH_REGISTER_WINDOW_SECONDS=900
